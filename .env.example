# Скопируйте в .env.local и заполните. В git этот файл не попадает.

# ── База данных (Neon) ────────────────────────────────────────────────
# DATABASE_URL — обязательно POOLED-хост, с «-pooler» в имени.
# Его читает приложение (src/lib/prisma.ts): на serverless каждый инстанс
# функции открывает своё соединение, и без pgBouncer база упирается в лимит.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/studydb?sslmode=require"

# DIRECT_URL — прямой хост, без «-pooler». Его читает prisma.config.ts,
# и нужен он только миграциям: через pgBouncer они не проходят.
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/studydb?sslmode=require"

# ── Сессии ────────────────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать:  openssl rand -base64 32
AUTH_SECRET=""

# ── Хранилище файлов (Cloudflare R2) ──────────────────────────────────
# Бакет должен быть ЗАКРЫТЫМ: файлы отдаются только по подписанным ссылкам
# с коротким сроком жизни. Публичный бакет обнуляет всю систему доступа.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="study-materials"
